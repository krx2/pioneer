# Copy this file to .env and fill in real values. Never commit .env itself.

# Local LLM, served behind an OpenAI-compatible endpoint (Ollama, llama.cpp, vLLM, ...).
PIONEER_LLM_BASE_URL=http://localhost:11434/v1
PIONEER_LLM_MODEL=

# Only needed if your local server is configured to require one. Leave blank otherwise.
PIONEER_LLM_API_KEY=

# Set to 1 to also run tests/end_to_end/test_live_model.py against the model above (slow).
PIONEER_LIVE_LLM_TESTS=

# Set to 1 to have the web UI ask the model to judge its own answers (LLM-as-a-judge).
# Costs an extra model call per answer and per suggested build site.
PIONEER_LLM_JUDGE=

# Where to look for .sav files -- the most recently modified one is used, which is normally the
# latest autosave. Leave blank to use the game's own dedicated-server save folder,
# %LOCALAPPDATA%\FactoryGame\Saved\SaveGames\server (set this only if yours lives elsewhere).
# A save picked in the web UI's Save panel takes its place (kept in data/settings.json).
PIONEER_SAVE_DIR=

# The game's SaveGames folder, whose saves the web UI's Save panel lists (Steam, Epic and
# dedicated-server saves alike). Leave blank for %LOCALAPPDATA%\FactoryGame\Saved\SaveGames.
PIONEER_SAVE_ROOT=

# Dedicated Satisfactory server connection info. The web UI's Server panel can set these too (kept
# in data/settings.json, which then wins over this file).
PIONEER_SERVER_HOST=
PIONEER_SERVER_PORT=

# Application token for the Dedicated Server HTTPS API: run `server.GenerateAPIToken` in the
# server's console and paste what it prints. Or log in with the admin password in the web UI's
# Server panel, which has the server make one.
PIONEER_SERVER_API_TOKEN=

# The dedicated server's folder or its FactoryServer.exe -- only `python startup.py` uses this,
# to start the server along with the model and the web UI. Leave blank for the usual Steam path.
PIONEER_SERVER_EXE=
